# LLM provider -- "bedrock" (default) or "openai". Only the section for the one you pick
# needs real credentials; the other can stay blank.
LLM_PROVIDER=bedrock

# AWS / Bedrock -- Claude Haiku 4.5 for both agents.
AWS_REGION=ap-southeast-1

# Credentials -- pick ONE of the two options below, don't set both.
#
# Option A: you already run `aws configure` / have ~/.aws/credentials -- just name the profile.
AWS_PROFILE=default
#
# Option B: no AWS CLI installed -- paste an access key pair here instead (from IAM ->
# Users -> Security credentials -> Create access key). load_dotenv() puts these into the
# process environment, which boto3 reads directly, no CLI or ~/.aws needed.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Verify this against `aws bedrock list-foundation-models` (or the Bedrock console's Model
# catalog) in your account/region before a demo -- Bedrock model ids change over time, and you
# must separately request model access for Claude Haiku in the Bedrock console before this
# will work, even with valid credentials.
BEDROCK_MODEL_ID=apac.anthropic.claude-haiku-4-5-20250929-v1:0

# OpenAI -- only used when LLM_PROVIDER=openai. Get a key from platform.openai.com/api-keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Routing -- "google" (Distance Matrix API), "onemap" (Singapore government, free), or
# "haversine" (straight-line estimate, no credentials needed). An unset/failing provider falls
# back to haversine automatically, e.g. in tests and offline demos.
ROUTING_PROVIDER=google

# Google Maps -- only used when ROUTING_PROVIDER=google. A plain Maps API key with the
# Distance Matrix API enabled (console.cloud.google.com -> APIs & Services) -- NOT a service
# account, that's only needed for the separate Route Optimization API.
GOOGLE_MAPS_API_KEY=

# OneMap -- only used when ROUTING_PROVIDER=onemap.
# If you already have a token (from onemap.gov.sg's account dashboard, or a prior getToken
# call), set it here -- takes priority over email/password and skips the token exchange below.
ONEMAP_TOKEN=
# Otherwise, email/password -- the routing client exchanges these for a token itself.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Storage
DB_PATH=./data/dispatch.db

# Scheduling defaults
DEFAULT_JOB_DURATION_MINUTES=60
WORK_DAY_START=09:00
# The three ends of the day, and they are genuinely different times.
# No customer is promised an arrival after this; it clamps every stated and offered window.
ARRIVAL_CUTOFF=21:00
# Scoring only: work past this -- service and the drive home included -- is overtime. It must sit
# past a NORMAL completion, or an ordinary evening delivery is billed as overtime and the scorer
# learns to avoid the evening window.
SOFT_DAY_END=22:00
# The depot's own deadline: a route that cannot get home by this is infeasible, not expensive.
# Strictly later than SOFT_DAY_END, or the overtime term can never fire.
HARD_ROUTE_END=22:30

# Geocoding. Postal codes resolve to real building coordinates via OneMap (free, no key,
# Singapore's government address database), falling back to Google Geocoding, then to the postal
# district's centre -- which is recorded as approximate rather than passed off as precise.
# Results persist in the geocode_cache table, so a code is fetched once per database.
# Set to 0 to skip the lookups entirely and always use district centres.
GEOCODING_ENABLED=1

# Multi-day planning
# Pins "today" so a recorded demo and the tests behave identically every run. Blank = real date.
DEMO_BASE_DATE=
# Notice the operation needs: a customer may only be offered a date this many days out.
HORIZON_LEAD_DAYS_MIN=2
# How many weeks ahead to look for a Friday/Saturday pair that is fully published before
# giving up and escalating. A bound, not a target -- in practice the answer is this week or
# next, and this only stops an empty database scanning forever.
CYCLE_SEARCH_WEEKS=8
# A customer may only be inserted next to an existing stop within this many kilometres.
# Straight-line, and only a filter on which positions are worth testing -- the ranking is by
# added detour, which is a different and larger number.
ANCHOR_RADIUS_KM=10
# Scoring weights, in minutes. Opening an otherwise-empty delivery day costs this much; each
# step down the customer's preference order costs the second. Preference should break ties
# without overriding routing -- raise DAY_OPENING_PENALTY_MINUTES to consolidate days harder.
DAY_OPENING_PENALTY_MINUTES=60
PREFERENCE_PENALTY_PER_RANK=10
# Whether a job's SERVICE must finish inside the customer's STATED availability, not merely
# start in it. "I'm home 9 to 9:30" means they are there until 9:30, so a 30-minute job
# arriving at 9:22 runs through a gap they told us about. Set to 0 for the older, looser
# behaviour. It never applies to a locked window: a promised slot is an ARRIVAL window, and
# reserving service inside it would shorten every slot we promise.
REQUIRE_SERVICE_WITHIN_WINDOW=1
# OR-Tools burns its whole time budget regardless of convergence. Publishing a plan happens once
# and can look harder; candidate evaluation runs many solves per booking.
SOLVER_TIME_LIMIT_SECONDS=5
CANDIDATE_SOLVER_TIME_LIMIT_SECONDS=1
# Reject a provider drive time exceeding this multiple of the straight-line estimate. This is the
# Johor-detour filter for providers that return no route geometry (Google's Distance Matrix).
MAX_DRIVE_TIME_RATIO=4.0
# Migration only: whether existing dated jobs get their first window promoted to a locked window,
# making them immovable. Right for a demo; set 0 if a tight legacy day becomes infeasible.
MIGRATE_LOCK_EXISTING=1
